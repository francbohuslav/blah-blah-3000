<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BlahBlah3000</AssemblyName>
    <RootNamespace>BlahBlah3000</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\BlahBlah3000.ico</ApplicationIcon>
    <TieredPGO>true</TieredPGO>
    <Version>1.1.0</Version>
    <Authors>Bohuslav Franc</Authors>
    <Product>BlahBlah3000</Product>
    <Description>Local, offline speech-to-text for Windows: a tray app with built-in Whisper, a global hotkey and a REST API.</Description>
    <Copyright>Copyright (c) 2026 Bohuslav Franc</Copyright>
    <RepositoryUrl>https://github.com/francbohuslav/blah-blah-3000</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only needed for NotifyIcon; its implicit usings would clash with WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\BlahBlah3000.ico" />
  </ItemGroup>

  <!--
    A repeated single-file publish into the same folder drops the native Whisper libraries: the SDK deletes the files of the previous
    publish and, on the incremental run, does not copy the runtimes folder again. This copies them after every publish.
  -->
  <Target Name="CopyWhisperRuntimesToPublishDir" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_WhisperRuntimeFile Include="@(None)"
                           Condition="'%(None.TargetPath)' != '' And $([System.String]::new('%(None.TargetPath)').StartsWith('runtimes/'))" />
    </ItemGroup>
    <Error Condition="'@(_WhisperRuntimeFile)' == ''" Text="The native Whisper libraries (runtimes/*) were not found among the project items." />
    <Copy SourceFiles="@(_WhisperRuntimeFile)" DestinationFiles="@(_WhisperRuntimeFile->'$(PublishDir)%(TargetPath)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

</Project>
