<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BlahBlah3000</AssemblyName>
    <RootNamespace>BlahBlah3000</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\BlahBlah3000.ico</ApplicationIcon>
    <TieredPGO>true</TieredPGO>
    <Version>1.0.1</Version>
    <Authors>Bohuslav Franc</Authors>
    <Product>BlahBlah3000</Product>
    <Description>Local, offline speech-to-text for Windows: a tray app with built-in Whisper, a global hotkey and a REST API.</Description>
    <Copyright>Copyright (c) 2026 Bohuslav Franc</Copyright>
    <RepositoryUrl>https://github.com/francbohuslav/blah-blah-3000</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only needed for NotifyIcon; its implicit usings would clash with WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\BlahBlah3000.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

</Project>
