<Window x:Class="BlahBlah3000.AddReplacementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BlahBlah3000"
        Title="{local:Loc AR.Title}" Icon="pack://application:,,,/assets/BlahBlah3000.ico" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="14">
    <TextBlock Text="{local:Loc Set.Rep.Said}" FontWeight="SemiBold" />
    <TextBox x:Name="PatternBox" Margin="0,4,0,0" VerticalContentAlignment="Center" Padding="2,3" />
    <TextBlock Text="{local:Loc Set.Rep.Written}" FontWeight="SemiBold" Margin="0,12,0,0" />
    <TextBox x:Name="ReplacementBox" Margin="0,4,0,0" VerticalContentAlignment="Center" Padding="2,3" />
    <CheckBox x:Name="RegexCheck" Margin="0,12,0,0" Content="{local:Loc AR.Regex}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{local:Loc AR.Add}" Width="90" Padding="0,4" IsDefault="True" Click="OnAdd" />
      <Button Content="{local:Loc Set.Cancel}" Width="90" Padding="0,4" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
