<Window x:Class="BlahBlah3000.ModelDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BlahBlah3000"
        Title="{local:Loc MD.Title}" Icon="pack://application:,,,/assets/BlahBlah3000.ico" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
  <StackPanel Margin="18">
    <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="Body" Margin="0,10,0,0" TextWrapping="Wrap" />
    <ProgressBar x:Name="Bar" Margin="0,14,0,0" Height="14" Maximum="1" Visibility="Collapsed" />
    <TextBlock x:Name="ErrorText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="Firebrick" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="PrimaryButton" MinWidth="110" Padding="12,4" Click="OnPrimary" IsDefault="True" />
      <Button x:Name="SecondaryButton" MinWidth="90" Padding="12,4" Margin="8,0,0,0" Click="OnSecondary" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
