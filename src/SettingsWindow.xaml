<Window x:Class="BlahBlah3000.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BlahBlah3000"
        Title="{local:Loc Set.Title}" Icon="pack://application:,,,/assets/BlahBlah3000.ico" Width="640" Height="720" MinWidth="560" MinHeight="600"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabControl x:Name="SettingsTabs" Grid.Row="0">
      <TabItem Header="{local:Loc Set.Tab.General}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
          <TextBlock Text="{local:Loc Set.UiLanguage}" FontWeight="SemiBold" />
          <ComboBox x:Name="UiLanguageCombo" Margin="0,6,0,0" DisplayMemberPath="Label" SelectedValuePath="Code" />
          <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap" Text="{local:Loc Set.UiLanguage.Hint}" />

          <TextBlock Text="{local:Loc Set.Language}" FontWeight="SemiBold" Margin="0,16,0,0" />
          <ComboBox x:Name="LanguageCombo" Margin="0,6,0,0" DisplayMemberPath="Label" SelectedValuePath="Code" />
          <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap" Text="{local:Loc Set.Language.Hint}" />
          <TextBlock x:Name="TestResult" Margin="0,8,0,0" TextWrapping="Wrap" />

          <CheckBox x:Name="AutostartCheck" Margin="0,16,0,0" Content="{local:Loc Set.Autostart}" />
          <CheckBox x:Name="UpdatesCheck" Margin="0,6,0,0" Content="{local:Loc Set.CheckUpdates}" />

          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock Text="{local:Loc Set.Unload.Before}" VerticalAlignment="Center" />
            <TextBox x:Name="UnloadBox" Width="50" Margin="8,0,0,0" VerticalContentAlignment="Center" />
            <TextBlock Text="{local:Loc Set.Unload.After}" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="ActivationTab" Header="{local:Loc Set.Tab.Activation}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
          <TextBlock Text="{local:Loc Set.Hotkey}" FontWeight="SemiBold" />
          <DockPanel Margin="0,6,0,0">
            <Button Content="{local:Loc Set.Clear}" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,3" Click="OnClearHotkey" />
            <TextBox x:Name="HotkeyBox" IsReadOnly="True" VerticalContentAlignment="Center" PreviewKeyDown="OnHotkeyKeyDown"
                     ToolTip="{local:Loc Set.Hotkey.Tip}" />
          </DockPanel>
          <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap" Text="{local:Loc Set.Hotkey.Hint}" />
          <TextBlock x:Name="ActivationResult" Margin="0,8,0,0" TextWrapping="Wrap" />

          <TextBlock Text="{local:Loc Set.Ptt}" FontWeight="SemiBold" Margin="0,22,0,0" />
          <CheckBox x:Name="PttCheck" Margin="0,6,0,0" Content="{local:Loc Set.Ptt.Enable}" />
          <ComboBox x:Name="PttKeysCombo" Margin="0,6,0,0" DisplayMemberPath="Label" SelectedValuePath="Code" />
          <TextBlock x:Name="PttDelayLabel" Margin="0,10,0,0" />
          <Slider x:Name="PttDelaySlider" Minimum="100" Maximum="1500" TickFrequency="50" IsSnapToTickEnabled="True"
                  Margin="0,2,0,0" ValueChanged="OnSliderChanged" />
          <CheckBox x:Name="PttLatchCheck" Margin="0,10,0,0" Content="{local:Loc Set.Ptt.Latch}" />
          <TextBlock x:Name="PttAutoStopLabel" Margin="24,8,0,0"
                     IsEnabled="{Binding IsChecked, ElementName=PttLatchCheck}" />
          <Slider x:Name="PttAutoStopSlider" Minimum="0" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" Margin="24,2,0,0"
                  IsEnabled="{Binding IsChecked, ElementName=PttLatchCheck}" ValueChanged="OnSliderChanged" />
          <CheckBox x:Name="PttSoundsCheck" Margin="0,6,0,0" Content="{local:Loc Set.Ptt.Sounds}" />
          <TextBlock x:Name="PttDuckLabel" Margin="0,10,0,0" />
          <Slider x:Name="PttDuckSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,2,0,0"
                  ValueChanged="OnSliderChanged" />
          <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap" Text="{local:Loc Set.Ptt.Hint}" />
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="LlmTab" Header="{local:Loc Set.Tab.Llm}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
          <TextBlock TextWrapping="Wrap" Text="{local:Loc Set.Llm.Intro}" />
          <CheckBox x:Name="LlmCheck" Margin="0,10,0,0" Content="{local:Loc Set.Llm.Enable}" />

          <TextBlock Text="{local:Loc Set.Llm.Provider}" FontWeight="SemiBold" Margin="0,14,0,0" />
          <ComboBox x:Name="LlmProviderCombo" Margin="0,6,0,0" DisplayMemberPath="Label" SelectionChanged="OnLlmProviderChanged" />
          <TextBlock Text="{local:Loc Set.Llm.Url}" FontWeight="SemiBold" Margin="0,10,0,0" />
          <TextBox x:Name="LlmUrlBox" Margin="0,6,0,0" VerticalContentAlignment="Center" />
          <TextBlock Text="{local:Loc Set.Llm.Model}" FontWeight="SemiBold" Margin="0,10,0,0" />
          <TextBox x:Name="LlmModelBox" Margin="0,6,0,0" VerticalContentAlignment="Center" />
          <TextBlock Text="{local:Loc Set.Llm.Key}" FontWeight="SemiBold" Margin="0,10,0,0" />
          <PasswordBox x:Name="LlmKeyBox" Margin="0,6,0,0" VerticalContentAlignment="Center" />
          <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap" Text="{local:Loc Set.Llm.Key.Hint}" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="LlmTestButton" Content="{local:Loc Set.Llm.Test}" Padding="12,4" Click="OnLlmTest" />
          </StackPanel>
          <TextBlock x:Name="LlmResult" Margin="0,8,0,0" TextWrapping="Wrap" />

          <DockPanel Margin="0,14,0,0">
            <Button Content="{local:Loc Set.Llm.Prompt.Reset}" DockPanel.Dock="Right" Padding="10,3" Click="OnLlmPromptReset" />
            <TextBlock Text="{local:Loc Set.Llm.Prompt}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <TextBox x:Name="LlmPromptBox" Margin="0,6,0,0" Height="130" TextWrapping="Wrap" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
          <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap" Text="{local:Loc Set.Llm.Prompt.Hint}" />

          <CheckBox x:Name="LlmAutoCheck" Margin="0,14,0,0" Content="{local:Loc Set.Llm.Auto}" />
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{local:Loc Set.Tab.Recording}">
        <StackPanel Margin="14">
          <TextBlock Text="{local:Loc Set.Mic}" FontWeight="SemiBold" />
          <ComboBox x:Name="MicCombo" Margin="0,6,0,14" DisplayMemberPath="Label" SelectionChanged="OnMicChanged" />
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Text="{local:Loc Set.Sens.Intro}" />
          <TextBlock Text="{local:Loc Set.Level}" FontWeight="SemiBold" />
          <ProgressBar x:Name="LevelBar" Height="10" Maximum="3000" Margin="0,6,0,0" Foreground="#81c995" />
          <Slider x:Name="ThresholdSlider" Minimum="0" Maximum="3000" TickFrequency="50" IsSnapToTickEnabled="True"
                  Margin="0,2,0,0" ValueChanged="OnSliderChanged" />
          <TextBlock x:Name="ThresholdLabel" Margin="0,2,0,0" />
          <TextBlock Text="{local:Loc Set.Pause.Title}" FontWeight="SemiBold" Margin="0,22,0,0" />
          <Slider x:Name="PauseSlider" Minimum="300" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True"
                  Margin="0,6,0,0" ValueChanged="OnSliderChanged" />
          <TextBlock x:Name="PauseLabel" Margin="0,2,0,0" />
        </StackPanel>
      </TabItem>

      <TabItem Header="{local:Loc Set.Tab.Hint}">
        <Grid Margin="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Text="{local:Loc Set.Hint.Intro}" />
          <TextBox x:Name="PromptBox" Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                   VerticalContentAlignment="Top" />
        </Grid>
      </TabItem>

      <TabItem x:Name="ReplacementsTab" Header="{local:Loc Set.Tab.Replacements}">
        <Grid Margin="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Text="{local:Loc Set.Rep.Intro}" />
          <DataGrid x:Name="RulesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True"
                    CanUserDeleteRows="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{local:Loc Set.Rep.Said}" Binding="{Binding Pattern}" Width="*" />
              <DataGridTextColumn Header="{local:Loc Set.Rep.Written}" Binding="{Binding Replacement}" Width="*" />
              <DataGridCheckBoxColumn Header="{local:Loc Set.Rep.Regex}" Binding="{Binding IsRegex, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="ReplacementsResult" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" />
        </Grid>
      </TabItem>

      <TabItem x:Name="AdvancedTab" Header="{local:Loc Set.Tab.Advanced}">
        <StackPanel Margin="14">
          <TextBlock Text="{local:Loc Set.Api}" FontWeight="SemiBold" />
          <CheckBox x:Name="ApiCheck" Margin="0,6,0,0" Content="{local:Loc Set.Api.Enable}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="{local:Loc Set.Port}" VerticalAlignment="Center" />
            <TextBox x:Name="PortBox" Width="70" Margin="8,0,0,0" VerticalContentAlignment="Center" />
            <CheckBox x:Name="ListenAllCheck" Margin="16,0,0,0" VerticalAlignment="Center" Content="{local:Loc Set.ListenAll}" />
          </StackPanel>
          <TextBlock x:Name="AdvancedResult" Margin="0,8,0,0" TextWrapping="Wrap" />

          <TextBlock Text="{local:Loc Set.Debug.Title}" FontWeight="SemiBold" Margin="0,22,0,0" />
          <CheckBox x:Name="DebugCheck" Margin="0,6,0,0" Content="{local:Loc Set.Debug}" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{local:Loc Set.Save}" Width="90" Padding="0,4" Click="OnSave" />
      <Button Content="{local:Loc Set.Cancel}" Width="90" Padding="0,4" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
