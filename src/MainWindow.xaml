<Window x:Class="BlahBlah3000.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BlahBlah3000"
        Title="BlahBlah3000" Icon="pack://application:,,,/assets/BlahBlah3000.ico" Width="1040" Height="240"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Background="#202124" PreviewKeyDown="OnPreviewKeyDown">
  <Window.Resources>
    <!-- Flat icon button for the dark window: no border, a subtle highlight on hover, and a disabled button only dims the icon. -->
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="6" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#3c4043" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#4a4d51" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.3" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border BorderBrush="#5f6368" BorderThickness="1" Padding="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,8" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="OnHeaderMouseDown"
                 ToolTip="{local:Loc Main.DragTip}">
        <TextBlock FontSize="14" Margin="0,0,14,0" Foreground="#e8eaed">
          <Run Text="BlahBlah3000" FontWeight="SemiBold" /><Run x:Name="AppVersion" Foreground="#9aa0a6" />
        </TextBlock>
        <TextBlock x:Name="Status" Text="{local:Loc Main.OpeningMic}" Foreground="#9aa0a6" FontSize="14" />
        <TextBlock x:Name="WhisperInfo" Margin="14,0,0,0" FontSize="14" Foreground="#9aa0a6"
                   MouseLeftButtonDown="OnWhisperInfoClick" />
        <Button Style="{StaticResource IconButton}" Content="&#xE713;" DockPanel.Dock="Right" Margin="6,-5,0,-5"
                Foreground="#bdc1c6" ToolTip="{local:Loc Main.SettingsTip}" ToolTipService.Placement="Left" Click="OnSettingsClick" />
        <Button x:Name="AddRuleButton" Style="{StaticResource IconButton}" Content="&#xE8AB;" DockPanel.Dock="Right"
                Margin="6,-5,0,-5" Foreground="#8ab4f8" IsEnabled="False" ToolTipService.Placement="Left"
                ToolTip="{local:Loc Main.AddRuleTip}" Click="OnAddRuleClick" />
        <Button x:Name="RevertButton" Style="{StaticResource IconButton}" Content="&#xE7A7;" DockPanel.Dock="Right"
                Margin="6,-5,0,-5" Foreground="#bdc1c6" Visibility="Collapsed" ToolTipService.Placement="Left"
                ToolTip="{local:Loc Main.RevertTip}" Click="OnRevertClick" />
        <Button x:Name="FixButton" Style="{StaticResource IconButton}" Content="&#xE70F;" DockPanel.Dock="Right"
                Margin="6,-5,0,-5" Foreground="#fdd663" Visibility="Collapsed" ToolTipService.Placement="Left"
                ToolTip="{local:Loc Main.FixTip}" Click="OnFixClick" />
        <TextBlock x:Name="HintText" Text="{local:Loc Main.Hint.Paste}" Foreground="#9aa0a6" FontSize="12"
                   DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,28,0" />
      </DockPanel>
      <RichTextBox x:Name="Transcript" Grid.Row="1" Background="#2b2c2f" Foreground="#e8eaed" CaretBrush="#e8eaed"
                   SelectionBrush="#5f6368" BorderThickness="0" Padding="6" FontSize="18"
                   AcceptsReturn="False" VerticalScrollBarVisibility="Auto" IsDocumentEnabled="True"
                   IsInactiveSelectionHighlightEnabled="True" SelectionChanged="OnTranscriptSelectionChanged" TextChanged="OnTranscriptTextChanged">
        <RichTextBox.Resources>
          <Style TargetType="Paragraph">
            <Setter Property="Margin" Value="0" />
          </Style>
        </RichTextBox.Resources>
      </RichTextBox>
      <ProgressBar x:Name="Level" Grid.Row="2" Height="4" Maximum="1" Margin="0,8,0,0"
                   Background="#3c4043" Foreground="#81c995" BorderThickness="0" />
      <TextBlock x:Name="UpdateLink" Grid.Row="3" Margin="0,8,0,0" FontSize="12" Foreground="#8ab4f8" Cursor="Hand"
                 Visibility="Collapsed" MouseLeftButtonDown="OnUpdateClick" />
    </Grid>
  </Border>
</Window>
