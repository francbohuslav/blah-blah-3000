<Window x:Class="BlahBlah3000.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BlahBlah3000"
        Title="{local:Loc FR.Title}" Icon="pack://application:,,,/assets/BlahBlah3000.ico" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="20">
    <TextBlock Text="{local:Loc FR.Welcome}" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap" Text="{local:Loc FR.Intro}" />

    <TextBlock Text="{local:Loc FR.Step1}" FontWeight="SemiBold" Margin="0,18,0,0" />
    <ComboBox x:Name="LanguageCombo" Margin="0,6,0,0" DisplayMemberPath="Label" SelectedValuePath="Code" />
    <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap" Text="{local:Loc FR.Step1.Hint}" />

    <TextBlock Text="{local:Loc FR.Step2}" FontWeight="SemiBold" Margin="0,18,0,0" />
    <TextBlock x:Name="ModelText" Margin="0,6,0,0" TextWrapping="Wrap" />
    <ProgressBar x:Name="ModelBar" Margin="0,8,0,0" Height="12" Maximum="1" Visibility="Collapsed" />
    <TextBlock x:Name="ModelError" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="Firebrick" Visibility="Collapsed" />
    <Button x:Name="ModelButton" Margin="0,8,0,0" HorizontalAlignment="Left" Padding="12,4" Click="OnModelButton" />

    <TextBlock Text="{local:Loc FR.Step3}" FontWeight="SemiBold" Margin="0,18,0,0" />
    <TextBox x:Name="HotkeyBox" Margin="0,6,0,0" IsReadOnly="True" VerticalContentAlignment="Center" Padding="2,4"
             PreviewKeyDown="OnHotkeyKeyDown" ToolTip="{local:Loc FR.Hotkey.Tip}" />
    <TextBlock x:Name="HotkeyHint" Margin="0,4,0,0" TextWrapping="Wrap" />

    <CheckBox x:Name="AutostartCheck" Margin="0,18,0,0" Content="{local:Loc Set.Autostart}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="FinishButton" Content="{local:Loc FR.Done}" MinWidth="110" Padding="12,4" IsDefault="True" Click="OnFinish" />
    </StackPanel>
  </StackPanel>
</Window>
